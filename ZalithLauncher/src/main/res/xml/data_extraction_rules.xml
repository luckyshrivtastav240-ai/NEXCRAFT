<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The PIN ciphertext cannot be decrypted without the device Keystore key. -->
        <exclude domain="sharedpref" path="nexcraft_app_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer a PIN ciphertext without its original Keystore key. -->
        <exclude domain="sharedpref" path="nexcraft_app_lock.xml" />
    </device-transfer>
</data-extraction-rules>
